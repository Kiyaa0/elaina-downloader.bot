# Telegram Bot Token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# (Optional) MTProto API credentials from https://my.telegram.org
# Enables native sending of large files up to 2000 MB (2 GB)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Admin Telegram User IDs (separated by comma, e.g. 123456789,987654321)
ADMIN_IDS=

# Optional Limits
MAX_FILE_SIZE_MB=50
MAX_DURATION_SECONDS=600
RATE_LIMIT_MAX_REQUESTS=3
RATE_LIMIT_WINDOW_SECONDS=900
COOKIES_FILE=cookies.txt

# Trakteer donation URL & optional Webhook
TRAKTEER_URL=https://trakteer.id/Kiyawi
TRAKTEER_WEBHOOK_SECRET=
TRAKTEER_WEBHOOK_PORT=8080

